<!-- index.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <link rel="stylesheet" href="/styles.css">

  <title><%= title %></title>
</head>
<body>
  <h1><%= title %></h1>

  <div class="messages-container">
    <% messages.forEach((message) => { %>
      <div class="message-card">
        <h3><%= message.user %></h3>
        <p><%= message.text %></p>
        <small><%= message.added %></small>
      </div>
    <% }); %>
  </div>
</body>
</html>